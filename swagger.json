{
  "openapi": "3.0.0",
  "info": {
    "title": "Books API",
    "version": "1.0.0",
    "description": "A simple API for working with books"
  },
  "servers": [
    {
      "url": "/",
      "description": "Current server"
    }
  ],
  "paths": {
    "/books": {
      "get": {
        "summary": "Retrieve all books",
        "description": "Returns a list of all books stored in MongoDB.",
        "tags": [
          "Books"
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved all books.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "example": "b1"
                      },
                      "author": {
                        "type": "string",
                        "example": "George Orwell"
                      },
                      "title": {
                        "type": "string",
                        "example": "1984"
                      },
                      "publicationDate": {
                        "type": "string",
                        "format": "date",
                        "example": "1949-06-08"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Internal server error"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/books/{id}": {
      "get": {
        "summary": "Retrieve a book by ID",
        "description": "Returns a single book matching the provided ID.",
        "tags": [
          "Books"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "description": "Unique identifier of the book.",
            "schema": {
              "type": "string"
            },
            "example": "b1"
          }
        ],
        "responses": {
          "200": {
            "description": "Book retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "example": "b1"
                    },
                    "author": {
                      "type": "string",
                      "example": "George Orwell"
                    },
                    "title": {
                      "type": "string",
                      "example": "1984"
                    },
                    "publicationDate": {
                      "type": "string",
                      "format": "date",
                      "example": "1949-06-08"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid book ID.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Invalid book ID"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Book not found.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Book not found"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Internal server error"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/authors": {
      "get": {
        "summary": "Get all authors",
        "tags": [
          "Authors"
        ],
        "responses": {
          "200": {
            "description": "An array of authors, or an empty array if there are none.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Author"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Unable to retrieve authors.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthorError"
                },
                "example": {
                  "message": "Unable to retrieve authors."
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create an author",
        "tags": [
          "Authors"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Author"
              },
              "example": {
                "id": "a4",
                "name": "Example Author",
                "birthYear": 1980
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The newly created author.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Author"
                }
              }
            }
          },
          "400": {
            "description": "Required fields are missing or invalid, or the custom ID already exists.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthorError"
                },
                "examples": {
                  "invalidData": {
                    "value": {
                      "message": "Invalid author data"
                    }
                  },
                  "duplicateId": {
                    "value": {
                      "message": "Author id already exists"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/AuthorServerError"
          }
        }
      }
    },
    "/authors/{id}": {
      "get": {
        "summary": "Get an author by custom ID",
        "tags": [
          "Authors"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/AuthorId"
          }
        ],
        "responses": {
          "200": {
            "description": "The matching author.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Author"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/AuthorNotFound"
          },
          "500": {
            "$ref": "#/components/responses/AuthorServerError"
          }
        }
      },
      "put": {
        "summary": "Update an author",
        "description": "Updates name and birthYear while preserving the custom ID.",
        "tags": [
          "Authors"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/AuthorId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "birthYear"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Must not be blank; surrounding whitespace is trimmed."
                  },
                  "birthYear": {
                    "type": "integer"
                  }
                }
              },
              "example": {
                "name": "Updated Author",
                "birthYear": 1981
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated author, including when the values are unchanged.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Author"
                },
                "example": {
                  "id": "a4",
                  "name": "Updated Author",
                  "birthYear": 1981
                }
              }
            }
          },
          "400": {
            "description": "Required fields are missing or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthorError"
                },
                "example": {
                  "message": "Invalid author data"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/AuthorNotFound"
          },
          "500": {
            "$ref": "#/components/responses/AuthorServerError"
          }
        }
      },
      "delete": {
        "summary": "Delete an author",
        "description": "Authors with books cannot be deleted. Delete or reassign their books first.",
        "tags": [
          "Authors"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/AuthorId"
          }
        ],
        "responses": {
          "204": {
            "description": "Author deleted successfully. No response body."
          },
          "404": {
            "$ref": "#/components/responses/AuthorNotFound"
          },
          "409": {
            "description": "Author still has books; neither the author nor their books are deleted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthorError"
                },
                "example": {
                  "message": "Cannot delete author with existing books"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/AuthorServerError"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Author": {
        "type": "object",
        "required": [
          "id",
          "name",
          "birthYear"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Custom string ID, not MongoDB _id.",
            "example": "a4"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Author name; must not be blank and is trimmed before saving.",
            "example": "Example Author"
          },
          "birthYear": {
            "type": "integer",
            "example": 1980
          }
        }
      },
      "AuthorError": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string"
          }
        }
      }
    },
    "parameters": {
      "AuthorId": {
        "in": "path",
        "name": "id",
        "required": true,
        "description": "Custom author ID, not MongoDB _id.",
        "schema": {
          "type": "string"
        },
        "example": "a4"
      }
    },
    "responses": {
      "AuthorNotFound": {
        "description": "No author exists with that custom ID.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/AuthorError"
            },
            "example": {
              "message": "Author not found"
            }
          }
        }
      },
      "AuthorServerError": {
        "description": "Unexpected server or database error.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/AuthorError"
            },
            "example": {
              "message": "Internal server error"
            }
          }
        }
      }
    }
  },
  "tags": []
}