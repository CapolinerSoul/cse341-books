{
  "openapi": "3.0.0",
  "info": {
    "title": "Books API",
    "version": "1.0.0",
    "description": "A simple API for working with books"
  },
  "servers": [
    {
      "url": "/",
      "description": "Current server"
    }
  ],
  "paths": {
    "/books": {
      "get": {
        "summary": "Retrieve all books",
        "tags": [
          "Books"
        ],
        "responses": {
          "200": {
            "description": "An array of books, or an empty array if there are none.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Book"
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/BookServerError"
          }
        }
      },
      "post": {
        "summary": "Create a book",
        "tags": [
          "Books"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Book"
              },
              "example": {
                "id": "b4",
                "authorId": "a1",
                "title": "Example Book Title",
                "publicationDate": "2026-01-15"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The newly created book.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Book"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or missing fields, duplicate book ID, or an authorId that does not exist.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookError"
                },
                "examples": {
                  "invalidData": {
                    "value": {
                      "message": "Invalid book data"
                    }
                  },
                  "duplicateId": {
                    "value": {
                      "message": "Book id already exists"
                    }
                  },
                  "missingAuthor": {
                    "value": {
                      "message": "Author not found"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/BookServerError"
          }
        }
      }
    },
    "/books/{id}": {
      "get": {
        "summary": "Retrieve a book by custom ID",
        "tags": [
          "Books"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/BookId"
          }
        ],
        "responses": {
          "200": {
            "description": "The matching book.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Book"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/BookNotFound"
          },
          "500": {
            "$ref": "#/components/responses/BookServerError"
          }
        }
      },
      "put": {
        "summary": "Update a book",
        "description": "Replaces authorId, title, and publicationDate while preserving the book's custom ID.",
        "tags": [
          "Books"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/BookId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookUpdate"
              },
              "example": {
                "authorId": "a2",
                "title": "Updated Book Title",
                "publicationDate": "2026-02-20"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated book, including when the submitted values are unchanged.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Book"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or missing fields, or an authorId that does not exist.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookError"
                },
                "examples": {
                  "invalidData": {
                    "value": {
                      "message": "Invalid book data"
                    }
                  },
                  "missingAuthor": {
                    "value": {
                      "message": "Author not found"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/BookNotFound"
          },
          "500": {
            "$ref": "#/components/responses/BookServerError"
          }
        }
      },
      "delete": {
        "summary": "Delete a book",
        "tags": [
          "Books"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/BookId"
          }
        ],
        "responses": {
          "204": {
            "description": "Book deleted successfully. No response body."
          },
          "404": {
            "$ref": "#/components/responses/BookNotFound"
          },
          "500": {
            "$ref": "#/components/responses/BookServerError"
          }
        }
      }
    },
    "/authors": {
      "get": {
        "summary": "Get all authors",
        "tags": [
          "Authors"
        ],
        "responses": {
          "200": {
            "description": "An array of authors, or an empty array if there are none.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Author"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Unable to retrieve authors.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthorError"
                },
                "example": {
                  "message": "Unable to retrieve authors."
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create an author",
        "tags": [
          "Authors"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Author"
              },
              "example": {
                "id": "a4",
                "name": "Example Author",
                "birthYear": 1980
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The newly created author.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Author"
                }
              }
            }
          },
          "400": {
            "description": "Required fields are missing or invalid, or the custom ID already exists.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthorError"
                },
                "examples": {
                  "invalidData": {
                    "value": {
                      "message": "Invalid author data"
                    }
                  },
                  "duplicateId": {
                    "value": {
                      "message": "Author id already exists"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/AuthorServerError"
          }
        }
      }
    },
    "/authors/{id}": {
      "get": {
        "summary": "Get an author by custom ID",
        "tags": [
          "Authors"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/AuthorId"
          }
        ],
        "responses": {
          "200": {
            "description": "The matching author.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Author"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/AuthorNotFound"
          },
          "500": {
            "$ref": "#/components/responses/AuthorServerError"
          }
        }
      },
      "put": {
        "summary": "Update an author",
        "description": "Updates name and birthYear while preserving the custom ID.",
        "tags": [
          "Authors"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/AuthorId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "birthYear"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Must not be blank; surrounding whitespace is trimmed."
                  },
                  "birthYear": {
                    "type": "integer"
                  }
                }
              },
              "example": {
                "name": "Updated Author",
                "birthYear": 1981
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated author, including when the values are unchanged.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Author"
                },
                "example": {
                  "id": "a4",
                  "name": "Updated Author",
                  "birthYear": 1981
                }
              }
            }
          },
          "400": {
            "description": "Required fields are missing or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthorError"
                },
                "example": {
                  "message": "Invalid author data"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/AuthorNotFound"
          },
          "500": {
            "$ref": "#/components/responses/AuthorServerError"
          }
        }
      },
      "delete": {
        "summary": "Delete an author",
        "description": "Authors with books cannot be deleted. Delete or reassign their books first.",
        "tags": [
          "Authors"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/AuthorId"
          }
        ],
        "responses": {
          "204": {
            "description": "Author deleted successfully. No response body."
          },
          "404": {
            "$ref": "#/components/responses/AuthorNotFound"
          },
          "409": {
            "description": "Author still has books; neither the author nor their books are deleted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthorError"
                },
                "example": {
                  "message": "Cannot delete author with existing books"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/AuthorServerError"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Book": {
        "type": "object",
        "required": [
          "id",
          "authorId",
          "title",
          "publicationDate"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Nonblank custom string ID, not MongoDB _id.",
            "example": "b4"
          },
          "authorId": {
            "type": "string",
            "minLength": 1,
            "description": "Must match an existing author's custom ID.",
            "example": "a1"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "Must not be blank; surrounding whitespace is trimmed.",
            "example": "Example Book Title"
          },
          "publicationDate": {
            "type": "string",
            "format": "date",
            "description": "A real calendar date in YYYY-MM-DD format.",
            "example": "2026-01-15"
          }
        }
      },
      "BookUpdate": {
        "type": "object",
        "required": [
          "authorId",
          "title",
          "publicationDate"
        ],
        "properties": {
          "authorId": {
            "type": "string",
            "minLength": 1,
            "description": "Must match an existing author's custom ID."
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "Must not be blank; surrounding whitespace is trimmed."
          },
          "publicationDate": {
            "type": "string",
            "format": "date",
            "description": "A real calendar date in YYYY-MM-DD format."
          }
        }
      },
      "BookError": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "Author": {
        "type": "object",
        "required": [
          "id",
          "name",
          "birthYear"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Custom string ID, not MongoDB _id.",
            "example": "a4"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Author name; must not be blank and is trimmed before saving.",
            "example": "Example Author"
          },
          "birthYear": {
            "type": "integer",
            "example": 1980
          }
        }
      },
      "AuthorError": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string"
          }
        }
      }
    },
    "parameters": {
      "BookId": {
        "in": "path",
        "name": "id",
        "required": true,
        "description": "Custom book ID, not MongoDB _id.",
        "schema": {
          "type": "string"
        },
        "example": "b4"
      },
      "AuthorId": {
        "in": "path",
        "name": "id",
        "required": true,
        "description": "Custom author ID, not MongoDB _id.",
        "schema": {
          "type": "string"
        },
        "example": "a4"
      }
    },
    "responses": {
      "BookNotFound": {
        "description": "No book exists with that custom ID.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/BookError"
            },
            "example": {
              "message": "Book not found"
            }
          }
        }
      },
      "BookServerError": {
        "description": "Unexpected server or database error.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/BookError"
            },
            "example": {
              "message": "Internal server error"
            }
          }
        }
      },
      "AuthorNotFound": {
        "description": "No author exists with that custom ID.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/AuthorError"
            },
            "example": {
              "message": "Author not found"
            }
          }
        }
      },
      "AuthorServerError": {
        "description": "Unexpected server or database error.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/AuthorError"
            },
            "example": {
              "message": "Internal server error"
            }
          }
        }
      }
    }
  },
  "tags": []
}